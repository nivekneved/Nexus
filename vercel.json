{
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/health.py"
    },
    {
      "source": "/static/(.*)",
      "destination": "/static/$1"
    },
    {
      "source": "/store",
      "destination": "/static/store.html"
    },
    {
      "source": "/manual",
      "destination": "/static/Nexus_User_Manual.pdf"
    },
    {
      "source": "/donate",
      "destination": "/static/donations.html"
    },
    {
      "source": "/donations",
      "destination": "/static/donations.html"
    },
    {
      "source": "/license",
      "destination": "/static/license.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/download/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/",
      "destination": "/static/index.html"
    }
  ]
}
