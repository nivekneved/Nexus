# ==========================================
# 1. AI BRAIN (Gemini API Key)
# Get a free key at https://aistudio.google.com/
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here

# ==========================================
# 2. EMAIL SERVER SETTINGS (IMAP)
# ==========================================
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_16_char_app_password

# ==========================================
# 3. AGENT SAFETY & BEHAVIOR
# ==========================================
# DRY_RUN: If True, the agent only simulates actions without moving emails.
DRY_RUN=True

# Folders:
TRASH_FOLDER=[Gmail]/Trash
REVIEW_FOLDER=[Gmail]/Spam

# Confidence Thresholds:
# >= HIGH_CONFIDENCE (0.90) -> Moved directly to Trash
# >= MEDIUM_CONFIDENCE (0.70) -> Moved to Review Folder
HIGH_SPAM_THRESHOLD=0.90
MEDIUM_SPAM_THRESHOLD=0.70

# ==========================================
# 4. IMMUNITY SHIELD (NEVER DELETE)
# Comma-separated list of domains or exact emails that bypass AI and are always kept
# ==========================================
WHITELIST_DOMAINS=@gmail.com,@github.com,@google.com,@apple.com,@microsoft.com,@amazon.com

# ==========================================
# 5. INSTANT BLACKLIST (FAST-PATH TRASH)
# Comma-separated list of suspicious TLDs, domains, or banned keywords
# ==========================================
BLACKLIST_DOMAINS=.xyz,.top,.click,.buzz,.loan,.work,.fit
BLACKLIST_KEYWORDS=casino,viagra,lottery winner,inheritance fund,wire transfer required,claim 40%

# ==========================================
# 6. MOBILE DISPATCH & COMMS SENTINEL
# ==========================================
USER_NAME=Deven
USER_PHONE_NUMBER=+23058169420
MOBILE_NOTIFICATION_CHANNEL=WhatsApp  # Options: WhatsApp, SMS, Webhook, Local
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ==========================================
# 7. DASHBOARD SECURITY (CRITICAL FOR VPS)
# Generate a strong random token: python -c "import secrets; print(secrets.token_hex(32))"
# Leave blank to run in open dev mode on localhost only.
# NEVER leave blank if Nexus is exposed on a public VPS or network.
# ==========================================
NEXUS_DASHBOARD_TOKEN=

# ==========================================
# 8. PAYMENTS (PayPal REST API + MCB Mauritius)
# PayPal: https://developer.paypal.com/dashboard/applications/live
# ==========================================
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
